#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, rgba16f) uniform image2D history_image;

layout(push_constant) uniform ClampParams {
    float max_value;
    float exposure;
    float threshold;
} params;

void main() {
    const ivec2 size = imageSize(history_image);
    const ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= size.x || coord.y >= size.y) {
        return;
    }
    vec4 color = imageLoad(history_image, coord);
    color.rgb *= params.exposure;
    if (params.threshold > 0.0) {
        vec3 excess = max(color.rgb - params.threshold, vec3(0.0));
        color.rgb -= excess;
        color.rgb += excess / (vec3(1.0) + excess);
    }
    color.rgb = min(color.rgb, vec3(params.max_value));
    imageStore(history_image, coord, color);
}
